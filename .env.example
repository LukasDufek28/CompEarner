# Environment Variables
# Copy this file to .env.local for local development

# JWT Secret for authentication (generate with: openssl rand -base64 32)
JWT_SECRET=your-super-secret-jwt-key-here-change-this

# Admin credentials
ADMIN_USERNAME=admin
# Generate password hash with: node -e "console.log(require('bcryptjs').hashSync('yourpassword', 10))"
ADMIN_PASSWORD_HASH=$2a$10$examplehashhere

# Vercel KV Database (automatically provided by Vercel)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
